<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- ToSpec.Sdk consumes the public `ToSpec-Dev/redact-dotnet` engine as the
       ToSpec.Redact package (the redaction it applies locally is the same code the
       gateway runs). Until ToSpec.Redact is published to nuget.org, its packed
       .nupkg is vendored under ./local-packages and restored from this local source,
       so CI (and any community fork) restores with no external feed or auth. When
       ToSpec.Redact ships to nuget.org, drop the local source. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="tospec-local" value="./local-packages" />
  </packageSources>
</configuration>
